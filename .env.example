# Copia como .env en la raíz: cp .env.example .env
# ──────────────────────────────────────────────────────────────────────────

# Base de datos (levantada por docker-compose.yml → servicio "postgres")
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zunochat
DB_USER=admin
DB_PASSWORD=admin123

# Mínimo 32 caracteres (HS256)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Brevo (envío de OTP/notificaciones por correo) — opcional en dev, ver
# email.enabled en application-dev.properties
BREVO_API_KEY=

# ─── Subida de archivos (ver application.properties → app.storage.*) ───────
#
# STORAGE_PROVIDER=local (default si se omite) → guarda en disco, sin cuenta
# externa. No hace falta configurar nada más para este caso.
STORAGE_PROVIDER=local

# STORAGE_PROVIDER=cloudinary → sube a Cloudinary, necesita las tres:
# CLOUDINARY_CLOUD_NAME=tu-cloud-name
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
