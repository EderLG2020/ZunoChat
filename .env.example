# Copia como .env en la raíz: cp .env.example .env
# ──────────────────────────────────────────────────────────────────────────

# Base de datos (levantada por docker-compose.yml → servicio "postgres")
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zunochat
DB_USER=admin
DB_PASSWORD=admin123

# Mínimo 32 caracteres (HS256)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Resend (envío de OTP/notificaciones por correo) — opcional en dev, ver
# email.enabled en application-dev.properties. El remitente (resend.from.email
# en application-*.properties) debe pertenecer a un dominio verificado en
# Resend — con la cuenta sin verificar, solo se puede enviar a la casilla con
# la que te registraste, usando onboarding@resend.dev como remitente.
RESEND_API_KEY=

# ─── Subida de archivos (ver application.properties → app.storage.*) ───────
#
# STORAGE_PROVIDER=local (default si se omite) → guarda en disco, sin cuenta
# externa. No hace falta configurar nada más para este caso.
STORAGE_PROVIDER=local

# STORAGE_PROVIDER=cloudinary → sube a Cloudinary, necesita las tres:
# CLOUDINARY_CLOUD_NAME=tu-cloud-name
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ─── Login/registro con Google (ver application.properties → google.oauth.*) ─
#
# Credenciales del cliente OAuth "Web application" creado en Google Cloud
# Console → APIs & Services → Credentials → Create Credentials → OAuth
# client ID. Agregar http://localhost:5173 (y el dominio de producción) en
# "Authorized JavaScript origins" — NO hace falta un redirect URI real, el
# frontend usa el modo popup de Google Identity Services.
# El CLIENT_ID también va en client/.env como VITE_GOOGLE_CLIENT_ID (mismo
# valor, es público). El CLIENT_SECRET solo va acá — nunca al frontend.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
